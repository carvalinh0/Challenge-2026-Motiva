# Token estático usado SÓ pelos devices (sensor/proxy) que fazem push de
# medição por HTTP. Usuários do site autenticam por JWT (ver abaixo).
TOKEN=

# Banco (Prisma + SQLite). Caminho relativo à raiz de apps/api.
DATABASE_URL="file:./dev.db"

# Assinatura dos JWT emitidos por POST /api/auth/login. Trocar em produção
# por um valor longo e aleatório — quem tiver esse segredo consegue forjar
# qualquer token.
JWT_SECRET=
# Validade do token emitido, em segundos. Default: 86400 (24h).
JWT_EXPIRES_IN=

# Credenciais do único usuário que pode fazer login (não há tabela de
# usuários — ver LoginUseCase).
ADMIN_USER=
ADMIN_PASSWORD=

# Mesmo broker Mosquitto do proxy.
# MQTT_URL tem prioridade; senão MQTT_HOST/MQTT_PORT sao usados pra montar
# mqtt://host:port. Preencher com host:porta do TCP Proxy do Railway.
MQTT_URL=
MQTT_HOST=
MQTT_PORT=
MQTT_USER=
MQTT_PASSWORD=

# Ha quanto tempo sem noticia de um sensor (last_seen) ele ainda conta como
# "active" no filtro de GET /api/sensors. Em ms. Default: 48h.
SENSOR_ACTIVE_WINDOW_MS=

# Teto de requisicoes por minuto, por IP. Default: 600. Preflights (OPTIONS)
# nao entram na conta. Ao estourar, TODAS as rotas passam a responder 429 ate
# a janela virar — inclusive o login, entao nao deixe apertado demais.
RATE_LIMIT_PER_MINUTE=

# Nivel minimo de log exibido no terminal: debug | info | warn | error.
# Default: info. Use "debug" pra ver ate mensagens MQTT nao correlacionadas
# a nenhum pedido pendente (ex: sensor reportando sozinho no ciclo autonomo).
LOG_LEVEL=

# Porta HTTP. Default: 3000.
PORT=
